{
  "expo": {
    "name": "Digital Khata",
    "slug": "digital-khata",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.digitalkhata.app",
      "versionCode": 1,
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/khata-icon.png",
        "backgroundColor": "#0B9E59"
      }
    },
    "icon": "./assets/khata-icon.png",
    "plugins": ["expo-sharing", "expo-secure-store", "expo-notifications"]
  }
}
