# Merge reviewed values into the selected environment file. Never load as a second env file.
# No automatic production activation.
ADMIN_NOTIFICATION_WORKER_ENABLED=false
ADMIN_NOTIFICATION_PUSH_ENABLED=false
# Set securely only if Expo enhanced push security is enabled; do not put it in mobile/public env.
EXPO_ACCESS_TOKEN=
# Mobile override is optional: app.config.js already supplies extra.eas.projectId.
# EXPO_PUBLIC_EAS_PROJECT_ID=<your-project-uuid>
