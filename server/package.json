{
  "name": "digital-khata-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "dev": "node --env-file=.env.development --import=./src/config/startupGuard.js --watch src/index.js",
    "start": "npm run start:production",
    "start:testing": "node --env-file=.env.testing --import=./src/config/startupGuard.js src/index.js",
    "start:production": "node --env-file=.env.production --import=./src/config/startupGuard.js src/index.js",
    "indexes": "npm run indexes:development",
    "indexes:development": "node --env-file=.env.development --import=./src/config/startupGuard.js src/index.js --indexes",
    "indexes:testing": "node --env-file=.env.testing --import=./src/config/startupGuard.js src/index.js --indexes",
    "indexes:production": "node --env-file=.env.production --import=./src/config/startupGuard.js src/index.js --indexes",
    "test:env": "node --test src/config/environment.test.js",
    "test:payments": "node --test src/providers/cashfree.test.js src/services/subscriptionPricing.test.js src/services/cashfreeLifecycle.test.js"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "mongoose": "^8.19.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^10.2.1",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "zod": "^4.1.12"
  }
}
